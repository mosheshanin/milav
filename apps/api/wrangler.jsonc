{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "milav",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // Worker раздаёт собранное мини-приложение и отвечает на /api/*
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
