{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "milav",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2025-09-01",
  // Журналы (Workers Logs, ROADMAP п. 9): ошибки сервера и приложения, события воронки (apps/api/src/telemetry.ts).
  // Бесплатно 200 000 записей в сутки, хранятся 3 дня; с 01.12.2026 бесплатно 0,5 ГБ в сутки (docs/DEPLOY.md).
  // invocation_logs: запись о каждом запросе к /api/* (адрес, код ответа, время процессора). Если упрёмся в лимит,
  // первым делом уменьшить head_sampling_rate (доля запросов, которые попадают в журнал).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": true }
  },
  // Worker раздаёт собранное мини-приложение и отвечает на /api/*
  "assets": {
    "directory": "apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // База данных: пользователи, прогресс, результаты викторин
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "milav-db",
      "database_id": "afdd253d-ac34-4e24-8230-be98afdb4c6c",
      "migrations_dir": "migrations"
    }
  ],
  // Распознавание речи (Whisper)
  "ai": { "binding": "AI" },

  // Таблица лидеров включена решением владельца 14.10.2026 (без отдельной политики конфиденциальности: участие
  // добровольное, имя из Telegram, выйти можно в любой момент). Выключить: "0", участники и очки сохраняются.
  "vars": { "LEADERBOARD_ENABLED": "1" },

  // Локальная разработка: npm run dev:api (без Workers AI и с тестовым входом)
  "env": {
    "local": {
      "main": "apps/api/src/index.ts",
      "compatibility_date": "2025-09-01",
      "assets": {
        "directory": "apps/web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "milav-db",
          "database_id": "afdd253d-ac34-4e24-8230-be98afdb4c6c",
          "migrations_dir": "migrations"
        }
      ],
      // TEMPLATE_RECORDER_IDS: тестовый «записывающий» для локальной разработки и сквозного теста (id тестового входа).
      // В продакшене это секрет Cloudflare с настоящим Telegram id владельца, в репозитории его нет.
      // LEADERBOARD_ENABLED: таблица лидеров включена локально, чтобы её проверял сквозной тест.
      "vars": { "ALLOW_DEV_AUTH": "true", "TEMPLATE_RECORDER_IDS": "1001", "LEADERBOARD_ENABLED": "1" }
    }
  }
}
