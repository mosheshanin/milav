{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Урок Milav",
  "description": "Формат файла content/lessons/<id урока>.json. Правила и стандарт транскрипции: docs/CONTENT.md. Проверка: npm run validate:content.",
  "type": "object",
  "required": ["id", "topicId", "section", "topic", "number", "free", "title"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Ссылка на эту схему, чтобы редактор подсказывал поля: \"../schema.json\"."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*-[1-9][0-9]*$",
      "description": "<topicId>-<номер>, например animals-1. Совпадает с именем файла."
    },
    "topicId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Постоянный латинский ключ темы, например animals."
    },
    "section": {
      "enum": ["nouns", "verbs", "adjectives", "alphabet"],
      "description": "Раздел: nouns (существительные), verbs (глаголы), adjectives (прилагательные), alphabet (алфавит: в уроке letters вместо words)."
    },
    "topic": { "$ref": "#/definitions/text", "description": "Название темы на экране, например «Животные»." },
    "number": {
      "type": "integer",
      "minimum": 1,
      "description": "Номер урока внутри темы, начиная с 1, без пропусков."
    },
    "free": {
      "type": "boolean",
      "description": "Бесплатный ли урок: true у первого урока темы, у остальных false. Уроки алфавита всегда бесплатные."
    },
    "title": { "$ref": "#/definitions/text", "description": "Название урока, например «Знакомые животные»." },
    "words": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/definitions/word" },
      "description": "Ровно 10 слов (у уроков обычных разделов; у урока алфавита вместо них letters)."
    },
    "letters": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "$ref": "#/definitions/letter" },
      "description": "Только у урока алфавита: 5–6 форм, а у урока звуков дж, ж, ч три формы с гереш. Какие именно буквы в каком уроке, задают ALPHABET_GROUPS в packages/shared (проверяют тесты)."
    }
  },
  "allOf": [
    {
      "if": { "required": ["number"], "properties": { "number": { "type": "integer", "maximum": 1 } } },
      "then": { "properties": { "free": { "const": true } } },
      "else": {
        "if": { "required": ["section"], "properties": { "section": { "const": "alphabet" } } },
        "then": { "properties": { "free": { "const": true } } },
        "else": { "properties": { "free": { "const": false } } }
      }
    },
    {
      "if": { "required": ["section"], "properties": { "section": { "const": "alphabet" } } },
      "then": {
        "required": ["letters"],
        "not": { "required": ["words"] },
        "properties": {
          "topicId": { "const": "alphabet" },
          "id": { "type": "string", "pattern": "^alphabet-[1-9][0-9]*$" }
        }
      },
      "else": {
        "required": ["words"],
        "not": { "required": ["letters"] }
      }
    },
    {
      "if": { "required": ["section"], "properties": { "section": { "const": "nouns" } } },
      "then": {
        "properties": {
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["gender", "example"],
              "not": {
                "type": "object",
                "anyOf": [{ "required": ["forms"] }, { "required": ["verb"] }]
              }
            }
          }
        }
      }
    },
    {
      "if": { "required": ["section"], "properties": { "section": { "const": "verbs" } } },
      "then": {
        "properties": {
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["example", "verb"],
              "not": {
                "type": "object",
                "anyOf": [{ "required": ["forms"] }, { "required": ["gender"] }]
              }
            }
          }
        }
      }
    },
    {
      "if": { "required": ["section"], "properties": { "section": { "const": "adjectives" } } },
      "then": {
        "properties": {
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["example", "forms"],
              "not": {
                "type": "object",
                "anyOf": [{ "required": ["gender"] }, { "required": ["verb"] }]
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "text": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "hebrew": {
      "type": "string",
      "pattern": "^[א-ת]+$",
      "description": "Только буквы иврита, без огласовок. Конечные формы ך ם ן ף ץ только в конце слова (проверяют тесты)."
    },
    "niqqud": {
      "type": "string",
      "pattern": "^(?=.*[\\u05B0-\\u05BC\\u05C1\\u05C2])[א-ת\\u05B0-\\u05BC\\u05C1\\u05C2]+$",
      "description": "Слово с огласовками: те же буквы, что в he, плюс знаки огласовок. Уходит в синтезатор речи, на экране не показывается."
    },
    "translit": {
      "type": "string",
      "pattern": "^[абвгдежзийклмнопрстуфхцчшьэюя\\u0301]+([ -][абвгдежзийклмнопрстуфхцчшьэюя\\u0301]+)*$",
      "description": "Транскрипция кириллицей, строчные буквы. В слове из 2+ слогов ровно один знак ударения (U+0301) после ударной гласной. Стандарт: docs/CONTENT.md."
    },
    "phrase": {
      "type": "object",
      "required": ["he", "translit", "ru"],
      "additionalProperties": false,
      "properties": {
        "he": { "type": "string", "pattern": "^[א-ת]+( [א-ת]+)*$" },
        "translit": {
          "type": "string",
          "pattern": "^[абвгдежзийклмнопрстуфхцчшьэюя]+([ -][абвгдежзийклмнопрстуфхцчшьэюя]+)*$",
          "description": "Транскрипция фразы без знаков ударения."
        },
        "ru": { "$ref": "#/definitions/text" },
        "audio": {
          "type": "string",
          "pattern": "^/audio/[a-z0-9-]+\\.mp3$",
          "description": "Озвучка фразы: /audio/<id слова>-phrase.mp3. Заполняется скриптом озвучки."
        }
      }
    },
    "form": {
      "type": "object",
      "required": ["he", "niqqud", "translit"],
      "additionalProperties": false,
      "properties": {
        "he": { "$ref": "#/definitions/hebrew" },
        "niqqud": { "$ref": "#/definitions/niqqud" },
        "translit": { "$ref": "#/definitions/translit" },
        "audio": {
          "type": "string",
          "pattern": "^/audio/[a-z0-9-]+\\.mp3$",
          "description": "Озвучка формы: /audio/<id слова>-form-<f|mp|fp>.mp3. Заполняется скриптом озвучки."
        }
      }
    },
    "forms": {
      "type": "object",
      "required": ["f", "mp", "fp"],
      "additionalProperties": false,
      "description": "Остальные формы прилагательного: f женский род ед.ч., mp мужской род мн.ч., fp женский род мн.ч. Основная форма (мужской род ед.ч.) в самом слове.",
      "properties": {
        "f": { "$ref": "#/definitions/form" },
        "mp": { "$ref": "#/definitions/form" },
        "fp": { "$ref": "#/definitions/form" }
      }
    },
    "presentForms": {
      "type": "object",
      "required": ["ms", "fs", "mp", "fp"],
      "additionalProperties": false,
      "description": "Настоящее время (причастие): ms м.р. ед.ч., fs ж.р. ед.ч., mp м.р. мн.ч., fp ж.р. мн.ч.",
      "properties": {
        "ms": { "$ref": "#/definitions/form" },
        "fs": { "$ref": "#/definitions/form" },
        "mp": { "$ref": "#/definitions/form" },
        "fp": { "$ref": "#/definitions/form" }
      }
    },
    "pastForms": {
      "type": "object",
      "required": ["1s", "2ms", "2fs", "3ms", "3fs", "1p", "2mp", "2fp", "3p"],
      "additionalProperties": false,
      "description": "Прошедшее время: цифра лицо, s/p число, m/f род; у 1-го лица и у 3-го лица мн.ч. (3p) род не различается.",
      "properties": {
        "1s": { "$ref": "#/definitions/form" },
        "2ms": { "$ref": "#/definitions/form" },
        "2fs": { "$ref": "#/definitions/form" },
        "3ms": { "$ref": "#/definitions/form" },
        "3fs": { "$ref": "#/definitions/form" },
        "1p": { "$ref": "#/definitions/form" },
        "2mp": { "$ref": "#/definitions/form" },
        "2fp": { "$ref": "#/definitions/form" },
        "3p": { "$ref": "#/definitions/form" }
      }
    },
    "futureForms": {
      "type": "object",
      "required": ["1s", "2ms", "2fs", "3ms", "3fs", "1p", "2mp", "2fp", "3mp", "3fp"],
      "additionalProperties": false,
      "description": "Будущее время: полная таблица, у 3-го лица мн.ч. две формы (3mp и 3fp).",
      "properties": {
        "1s": { "$ref": "#/definitions/form" },
        "2ms": { "$ref": "#/definitions/form" },
        "2fs": { "$ref": "#/definitions/form" },
        "3ms": { "$ref": "#/definitions/form" },
        "3fs": { "$ref": "#/definitions/form" },
        "1p": { "$ref": "#/definitions/form" },
        "2mp": { "$ref": "#/definitions/form" },
        "2fp": { "$ref": "#/definitions/form" },
        "3mp": { "$ref": "#/definitions/form" },
        "3fp": { "$ref": "#/definitions/form" }
      }
    },
    "imperativeForms": {
      "type": "object",
      "required": ["ms", "fs", "mp", "fp"],
      "additionalProperties": false,
      "description": "Повелительное наклонение: ms, fs, mp, fp. Весь блок необязателен: у части глаголов его нет.",
      "properties": {
        "ms": { "$ref": "#/definitions/form" },
        "fs": { "$ref": "#/definitions/form" },
        "mp": { "$ref": "#/definitions/form" },
        "fp": { "$ref": "#/definitions/form" }
      }
    },
    "verb": {
      "type": "object",
      "required": ["binyan", "root", "present", "past", "future"],
      "additionalProperties": false,
      "description": "Данные глагола (только раздел «Глаголы»): бинъян, корень и формы по временам. Основная форма, инфинитив, лежит в he слова.",
      "properties": {
        "binyan": {
          "enum": ["paal", "nifal", "piel", "hifil", "hitpael"],
          "description": "Бинъян: paal, nifal, piel, hifil, hitpael (BINYAN_KEYS в packages/shared)."
        },
        "root": {
          "type": "string",
          "pattern": "^[אבגדהוזחטיכלמנסעפצקרשת]{3,4}$",
          "description": "Корень: 3–4 буквы иврита без конечных форм, например כתב."
        },
        "gizra": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["pe_nun", "pe_yod", "pe_alef", "pe_lamed", "ayin_vav", "ayin_yod", "lamed_he", "lamed_alef"] },
          "description": "Тип слабого корня (GIZRA_KEYS в packages/shared): 1–2 кода, основной первым. У сильных корней поля нет."
        },
        "present": { "$ref": "#/definitions/presentForms" },
        "past": { "$ref": "#/definitions/pastForms" },
        "future": { "$ref": "#/definitions/futureForms" },
        "imperative": { "$ref": "#/definitions/imperativeForms" }
      }
    },
    "reviewed": {
      "description": "false, пока слово не проверил носитель языка; после проверки { by, at }.",
      "oneOf": [
        { "const": false },
        {
          "type": "object",
          "required": ["by", "at"],
          "additionalProperties": false,
          "properties": {
            "by": { "$ref": "#/definitions/text" },
            "at": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" }
          }
        }
      ]
    },
    "hebrewGeresh": {
      "type": "string",
      "pattern": "^[א-ת׳]+$",
      "description": "Как hebrew, но допускается гереш ׳ (U+05F3) после буквы: слова с звуками дж, ж, ч (ג׳ינס, ז׳קט, צ׳יפס)."
    },
    "niqqudGeresh": {
      "type": "string",
      "pattern": "^(?=.*[\\u05B0-\\u05BC\\u05C1\\u05C2])[א-ת\\u05B0-\\u05BC\\u05C1\\u05C2׳]+$",
      "description": "Как niqqud, но допускается гереш ׳ (U+05F3) после буквы с огласовкой."
    },
    "hebrewPhrase": {
      "type": "string",
      "pattern": "^[א-ת]+( [א-ת]+)*$",
      "description": "Иврит только буквами, без огласовок; слова через пробел (название конечной формы: «כף סופית»)."
    },
    "niqqudPhrase": {
      "type": "string",
      "pattern": "^(?=.*[\\u05B0-\\u05BC\\u05C1\\u05C2])[א-ת\\u05B0-\\u05BC\\u05C1\\u05C2]+( [א-ת\\u05B0-\\u05BC\\u05C1\\u05C2]+)*$",
      "description": "То же с огласовками. Уходит в синтезатор речи, на экране не показывается."
    },
    "letterName": {
      "type": "object",
      "required": ["he", "niqqud", "ru"],
      "additionalProperties": false,
      "description": "Название буквы: иврит, огласовки для озвучки и русское название (то же, что LETTER_NAMES в packages/shared).",
      "properties": {
        "he": { "$ref": "#/definitions/hebrewPhrase" },
        "niqqud": { "$ref": "#/definitions/niqqudPhrase" },
        "ru": { "type": "string", "pattern": "^[а-яь]+( [а-яь]+)*$" }
      }
    },
    "letterExample": {
      "type": "object",
      "required": ["he", "niqqud", "translit", "ru"],
      "additionalProperties": false,
      "description": "Слово-пример: у обычной буквы начинается с неё, у конечной формы заканчивается ею.",
      "properties": {
        "he": { "$ref": "#/definitions/hebrewGeresh" },
        "niqqud": { "$ref": "#/definitions/niqqudGeresh" },
        "translit": { "$ref": "#/definitions/translit" },
        "ru": { "$ref": "#/definitions/text" },
        "image": {
          "type": "string",
          "pattern": "^/words/[a-z0-9-]+\\.(svg|png|webp)$",
          "description": "Путь от корня сайта: свой файл /words/<id буквы>-example.svg или файл такого же слова из обычного урока. Необязательно."
        },
        "audio": {
          "type": "string",
          "pattern": "^/audio/[a-z0-9-]+\\.mp3$",
          "description": "Озвучка слова-примера: свой файл /audio/<id буквы>-example.mp3 (заполняет скрипт озвучки) или файл такого же слова из обычного урока."
        }
      }
    },
    "letter": {
      "type": "object",
      "required": ["id", "he", "name", "sound", "example", "reviewed"],
      "additionalProperties": false,
      "description": "Одна из 27 форм алфавита (22 буквы и 5 конечных).",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*-[1-9][0-9]*-[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "<id урока>-<ключ из LETTER_KEYS>, например alphabet-1-alef. Прогресс пользователей привязан к id: после выпуска не менять."
        },
        "he": { "type": "string", "pattern": "^[א-ת]׳?$", "description": "Сама форма: одна буква иврита, а в уроке звуков дж, ж, ч буква с гереш (ג׳, ז׳, צ׳)." },
        "name": { "$ref": "#/definitions/letterName" },
        "sound": {
          "type": "string",
          "pattern": "^\\S(.*\\S)?$",
          "maxLength": 80,
          "description": "Звук кириллицей, как показывается ученику: «б», «б (с точкой), в (без точки)», у молчащей буквы объяснение."
        },
        "example": { "$ref": "#/definitions/letterExample" },
        "audio": {
          "type": "string",
          "pattern": "^/audio/[a-z0-9-]+\\.mp3$",
          "description": "Озвучка названия буквы: /audio/<id буквы>.mp3. Заполняется скриптом озвучки."
        },
        "reviewed": { "$ref": "#/definitions/reviewed" }
      }
    },
    "word": {
      "type": "object",
      "required": ["id", "he", "niqqud", "translit", "ru", "reviewed"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*-[1-9][0-9]*-[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "<id урока>-<ключ слова>, например animals-1-cat. Прогресс пользователей привязан к id: после выпуска не менять."
        },
        "he": { "$ref": "#/definitions/hebrew" },
        "niqqud": { "$ref": "#/definitions/niqqud" },
        "translit": { "$ref": "#/definitions/translit" },
        "ru": { "$ref": "#/definitions/text" },
        "gender": { "enum": ["m", "f"], "description": "Род: m мужской, f женский (у существительных)." },
        "example": { "$ref": "#/definitions/phrase" },
        "forms": { "$ref": "#/definitions/forms" },
        "verb": { "$ref": "#/definitions/verb" },
        "image": {
          "type": "string",
          "pattern": "^/words/[a-z0-9-]+\\.(svg|png|webp)$",
          "description": "Путь от корня сайта, файл в apps/web/public/words. Необязательно."
        },
        "audio": {
          "type": "string",
          "pattern": "^/audio/[a-z0-9-]+\\.mp3$",
          "description": "Путь к озвучке, файл в apps/web/public/audio. Заполняется скриптом озвучки."
        },
        "reviewed": { "$ref": "#/definitions/reviewed" }
      }
    }
  }
}
